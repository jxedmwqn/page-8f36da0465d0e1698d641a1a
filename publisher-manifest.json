          "version": 3,
          "body": "<style>\n:root{--brown:#3a2418;--brown-2:#5a3a28;--brown-3:#8a6a52;--mint:#bfe8d2;--mint-2:#e6f6ee;--paper:#faf5ee;--ink:#2a1c13;--line:rgba(58,36,24,.22)}\n*{box-sizing:border-box}\nhtml{}\nbody{margin:0;background:var(--paper);color:var(--ink);font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",system-ui,sans-serif;font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased}\na{color:var(--brown-2);text-decoration:none}\na:hover{text-decoration:underline}\n.wrap{max-width:980px;margin:0 auto;padding:0 22px}\n\n/* 顶部面包屑 + 目录 */\n.topbar{border-bottom:1px solid var(--line);background:var(--mint-2)}\n.crumbs{display:flex;flex-wrap:wrap;gap:8px;align-items:center;font-size:.82rem;letter-spacing:.02em;color:var(--brown-2);padding:12px 0 10px}\n.crumbs span{color:var(--brown-3)}\n.crumbs a{color:var(--brown-2)}\n.toc{display:flex;flex-wrap:wrap;gap:6px 0;padding:0 0 14px;font-size:.86rem}\n.toc a{padding:4px 12px;border:1px solid var(--line);border-radius:999px;margin-right:8px;background:#fff;color:var(--brown-2);white-space:nowrap}\n.toc a:hover{background:var(--brown);color:var(--mint);text-decoration:none;border-color:var(--brown)}\n\n/* 首屏：专栏式长文开篇 */\n.hero{padding:54px 0 46px}\n.hero .kicker{font-size:.78rem;letter-spacing:.22em;color:var(--brown-3);margin:0 0 18px}\nh1{margin:0 0 6px;font-size:clamp(2rem,5.2vw,3rem);line-height:1.18;letter-spacing:-.01em;color:var(--brown);font-weight:800}\n.hero .sub{margin:0 0 30px;font-size:1rem;color:var(--brown-3);letter-spacing:.04em}\n.hero-cols{display:grid;grid-template-columns:1.55fr .95fr;gap:38px;align-items:start}\n.hero-cols p{margin:0 0 18px}\n.hero-cols p:first-of-type::first-letter{float:left;font-size:2.9rem;line-height:.95;padding:6px 10px 0 0;color:var(--brown);font-weight:800}\n.pull{background:var(--mint);padding:20px 22px;border-left:6px solid var(--brown);font-size:.95rem;color:var(--brown)}\n.pull p{margin:0 0 10px}\n.pull p:last-child{margin-bottom:0}\n\n/* 区块通用