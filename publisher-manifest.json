yle:none;display:grid;gap:9px;position:relative;z-index:1}\n.plan li{padding-left:20px;position:relative;font-size:.95rem;color:#43302a}\n.plan li::before{content:\"\";position:absolute;left:0;top:.62em;width:9px;height:9px;background:var(--mint);border:1px solid var(--brown-2)}\n.plan-note{margin:22px 0 0;font-size:.86rem;color:var(--brown-3)}\n\n/* 客户端 */\n.clients{display:grid;gap:0;border-top:1px solid var(--line)}\n.client{display:grid;grid-template-columns:200px 1fr;gap:24px;padding:20px 0;border-bottom:1px solid var(--line);align-items:start}\n.client h3{margin:0;font-size:1rem}\n.client p{margin:0;font-size:.93rem;color:#43302a}\n.client .tags{font-size:.8rem;color:var(--brown-3);margin-top:5px;letter-spacing:.03em}\n\n/* FAQ：details 折叠 */\ndetails{border:1px solid var(--line);background:#fff;border-radius:3px;margin-bottom:10px;padding:0 18px}\ndetails[open]{background:var(--mint-2);border-color:var(--brown-3)}\nsummary{cursor:pointer;padding:16px 0;font-weight:700;color:var(--brown);list-style:none;display:flex;gap:12px;align-items:baseline;font-size:.97rem}\nsummary::-webkit-details-marker{display:none}\nsummary::before{content:\"+\";color:var(--brown-2);font-weight:800;width:14px;flex:none}\ndetails[open] summary::before{content:\"–\"}\ndetails p{margin:0 0 16px;padding-top:0;font-size:.93rem;color:#43302a;max-width:72ch}\n\n/* 页脚 */\nfooter{border-top:1px solid var(--line);background:var(--brown);color:var(--mint-2);padding:34px 0 40px;font-size:.86rem}\nfooter strong{color:#fff;font-size:1rem;display:block;margin-bottom:8px}\nfooter p{margin:0 0 8px;max-width:70ch;line-height:1.7}\n\n@media (max-width:760px){\n  .hero-cols,.qa-flow{grid-template-columns:1fr;gap:24px}\n  .hero{padding:36px 0 30px}\n  .client{grid-template-columns:1fr;gap:6px}\n  .plan{padding:22px 20px 26px}\n  .plan .num{font-size:5.5rem;bottom:-18px}\n  .step{grid-template-columns:44px 1fr;gap:12px}\n  section{padding:38px 0}\n}\n</style><div class=\"topbar\">\n  <div class=\"wrap\">\n    <nav class=\"crumbs\" aria-label=\"面包屑\">\n      <a href=\"#\">首页</a><span>/</span><a href=\"#plans\">套餐与价格</a><span>/</span><a href=\"#clients\">客户端</a><span>/</span><a href=\"#faq\">常见问题</a>\n    </nav>\n    <div class=\"toc\" aria-label=\"页面目录\">\n      <a href=\"#start\">先读这一段</a>\n      <a href=\"#plans\">套餐与价格</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#use\">使用步骤</a>\n      <a href=\"#faq\">常见问题</a>\n    </div>\n  </div>\n</div>\n\n<header class=\"hero\">\n  <div class=\"wrap\">\n    <p class=\"kicker\">接班人之家 · NicE CLOUD · 订阅说明页</p>\n    <h1>接班人之家(NiceCloud) · 接班人之家（NiceCloud）</h1>\n    <p class=\"sub\">把套餐、价格和怎么用，写在同一页里</p>\n\n    <div class=\"hero-cols\">\n      <div>\n        <p>很多人第一次接触订阅类服务，问题并不在“选哪个好”，而在“我到底在买什么”。所以我们把这一页写成一篇文章，而不是一张海报：先说清楚套餐之间的差别在哪里，再说清楚付完钱之后要做的每一步，最后把最常见的问题逐条拆开回答。</p>\n        <p>你会看到三档套餐。它们的区别不止是流量数字，还包括同时在线设备数、节点池的层级，以及支持渠道的响应顺序。如果你只想知道从哪里开始，可以直接跳到使用步骤；如果你想比较，就顺着往下读，每档套餐都单独占一块，不挤在一起。</p>\n        <p>我们也刻意没有使用“极速”“一键”“全球”这类词。这些词读起来省事，但看完之后你依然不知道自己买到了什么。下面所有描述都只讲可核对的部分：价格、流量、设备数、权益条目。</p>\n      </div>\n      <aside class=\"pull\">\n        <p>阅读顺序建议：</p>\n        <p>① 先看套餐的“同时在线设备数”，这一项通常最先卡住人；</p>\n        <p>② 再看流量额度与你实际的使用节奏是否匹配；</p>\n        <p>③ 最后看客户端，确认你手上的设备能装得上。</p>\n      </aside>\n    </div>\n  </div>\n</header>\n\n<main>\n\n<section id=\"start\">\n  <div class=\"wrap\">\n    <h2>先读这一段，再往下滚动</h2>\n    <p class=\"lede\">这里用问答的方式，把三个最常被问到的前提摊开讲。它们决定了你后面看套餐时该重点盯哪一行。</p>\n    <div class=\"qa-flow\">\n      <div>\n        <span class=\"q\">问：三档套餐最大的区别是什么？</span>\n        <p class=\"a\">答：不是单纯流量翻倍。基础版与旗舰版的差别延伸到设备数、流媒体解锁范围和线路类型；团队版则在带宽与路由配置上给出了更多可调整空间。选定前先确认你有几台设备要同时在线。</p>\n      </div>\n      <div>\n        <span class=\"q\">问：月付和年付怎么选？</span>\n        <p class=\"a\">答：年付在页面价格上等同于十个月的费用。如果你只是想先试一段，月付更轻；如果你已经确定会长期使用，年付能省下两个月的支出。</p>\n      </div>\n      <div>\n        <span class=\"q\">问：买了之后要多长时间才能用上？</span>\n        <p class=\"a\">答：开通后你会拿到订阅信息，接着在自己的设备上安装客户端并导入。整个过程在你的设备上完成，下面“使用步骤”一节按顺序写了每一步要做什么。</p>\n      </div>\n      <div>\n        <span class=\"q\">问：我不确定该选哪一档怎么办？</span>\n        <p class=\"a\">答：从设备数量倒推。手机、电脑、平板三台以内，基础版够用；如果还想同时挂上电视或第二台电脑，旗舰版的五台更从容；团队场景直接看团队版。</p>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"plans\">\n  <div class=\"wrap\">\n    <h2>套餐与价格</h2>\n    <p class=\"lede\">三档套餐按容量由小到大依次排列。每张卡片下面写着月付价格与年付折算，权益条目逐条列出，不做省略。</p>\n\n    <article class=\"plan\">\n      <span class=\"num\">01</span>\n      <div class=\"plan-head\">\n        <h3>基础版</h3>\n        <span class=\"price\">¥15<em>/月</em></span>\n        <span class=\"annual\">按年付 ¥150/年</span>\n      </div>\n      <ul>\n        <li>每月 100GB 流量额度</li>\n        <li>支持 3 台设备同时在线</li>\n        <li>基础流媒体解锁</li>\n        <li>普通线路节点池</li>\n      </ul>\n    </article>\n\n    <article class=\"plan\">\n      <span class=\"num\">02</span>\n      <div class=\"plan-head\">\n        <h3>旗舰版</h3>\n        <span class=\"price\">¥35<em>/月</em></span>\n        <span class=\"annual\">按年付 ¥350/年</span>\n        <span class=\"flag\">多数人的选择</span>\n      </div>\n      <ul>\n        <li>每月 300GB 流量额度</li>\n        <li>支持 5 台设备同时在线</li>\n        <li>全节点原生流媒体解锁</li>\n        <li>IPLC 专线游戏加速优化</li>\n        <li>7×24 优先工单支持</li>\n      </ul>\n    </article>\n\n    <article class=\"plan\">\n      <span class=\"num\">03</span>\n      <div class=\"plan-head\">\n        <h3>团队版</h3>\n        <span class=\"price\">¥85<em>/月</em></span>\n        <span class=\"annual\">按年付 ¥850/年</span>\n      </div>\n      <ul>\n        <li>每月 1000GB 流量额度</li>\n        <li>支持 20 台设备同时在线</li>\n        <li>VIP 专属高带宽节点</li>\n        <li>支持企业定制路由</li>\n        <li>专属客户经理服务</li>\n      </ul>\n    </article>\n\n    <p class=\"plan-note\">价格与权益以上方三张卡片为准。页面未列出具体下载地址与开通链接，相关入口请以你收到的订阅信息为准；如页面与订阅信息不一致，以订阅信息中的说明为优先。</p>\n  </div>\n</section>\n\n<section id=\"clients\">\n  <div class=\"wrap\">\n    <h2>客户端</h2>\n    <p class=\"lede\">不同系统的安装方式不一样，下面的说明按平台分开写，只讲你需要动手的部分。</p>\n    <div class=\"clients\">\n      <div class=\"client\">\n        <h3>桌面端</h3>\n        <div>\n          <p>在有图形界面的电脑上，安装客户端后找到“导入订阅”或“从链接添加”的入口，把订阅信息粘贴进去，保存后选择节点即可。首次连接前建议先确认客户端版本与你拿到的订阅格式匹配。</p>\n          <p class=\"tags\">常见系统：Windows、macOS、Linux 桌面环境</p>\n        </div>\n      </div>\n      <div class=\"client\">\n        <h3>移动端</h3>\n        <div>\n          <p>手机和平板上同样是通过订阅链接导入，导入完成后在应用内切换节点。移动端受系统后台策略影响较大，如果出现连接中断，先检查系统是否限制了该应用的后台活动。</p>\n          <p class=\"tags\">常见系统：Android、iOS</p>\n        </div>\n      </div>\n      <div class=\"client\">\n        <h3>路由器与共享场景</h3>\n        <div>\n          <p>如果你希望全家设备共用一份订阅，需要在支持订阅导入的路由器固件上配置。这一做法会占用多台设备额度，团队版的 20 台设备额度更适合这类场景。</p>\n          <p class=\"tags\">注意：共享会消耗同时在线设备数</p>\n        </div>\n      </div>\n      <div class=\"client\">\n        <h3>订阅更新</h3>\n        <div>\n          <p>当套餐或节点信息发生变化时，在客户端内重新拉取一次订阅即可完成更新，无需重新安装。若更新后节点数量异常，先检查订阅信息是否被截断或过期。</p>\n          <p class=\"tags\">操作：客户端内点击更新订阅</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"use\">\n  <div class=\"wrap\">\n    <h2>使用步骤</h2>\n    <p class=\"lede\">从拿到订阅到日常使用，一共四步。顺序不用调换，跳过任何一步都可能让后面卡住。</p>\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div>\n          <h3>确认套餐与设备数量</h3>\n          <p>先数清楚你打算同时在线的设备有几台。基础版 3 台、旗舰版 5 台、团队版 20 台，超出额度时多出的设备会挤占其他设备的连接。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>获取订阅信息</h3>\n          <p>订阅信息通常包含一条链接或一段配置文本。请把它当作密码对待，不要转发到公开群组或截图发布。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>安装客户端并导入</h3>\n          <p>按上一节按平台列出的方式安装，然后在应用内导入订阅信息。导入成功后，应用内应能看到可用节点列表。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div>\n          <h3>选择节点并开始使用</h3>\n          <p>优先选择延迟较低、负载较轻的节点。使用中若出现速度波动，切换到同套餐内的其他节点通常比反复重连更有效。</p>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>\n\n<section id=\"faq\">\n  <div class=\"wrap\">\n    <h2>常见问题</h2>\n    <p class=\"lede\">下面每一条都可以展开阅读。问题按出现的先后顺序排列，先讲购买前，再讲使用中。</p>\n\n    <details>\n      <summary>套餐里的流量是怎么计算的？</summary>\n      <p>流量按每个计费周期统计，基础版 100GB、旗舰版 300GB、团队版 1000GB。周期结束后额度重新开始计算，未用完的部分不结转到下一个周期。如果你不确定自己的用量，可以先从较低档位开始，之后按需调整。</p>\n    </details>\n\n    <details>\n      <summary>同时在线设备数超了会怎样？</summary>\n      <p>超出额度的设备可能无法连接，或导致某一台设备被挤下线。这不是故障，而是额度限制。基础版给到 3 台、旗舰版 5 台、团队版 20 台，选套餐时按你最高峰的设备数量来定更稳妥。</p>\n    </details>\n\n    <details>\n      <summary>年付和月付的差别只有价格吗？</summary>\n      <p>权益条目相同，差别在于计费方式。按年付时基础版为 ¥150、旗舰版 ¥350、团队版 ¥850，相当于十个月的月付费用。如果你只是短期需要，月付更灵活。</p>\n    </details>\n\n    <details>\n      <summary>更换设备后需要重新购买吗？</summary>\n      <p>不需要。订阅信息可以在新的设备上重新导入，只要同时在线的设备总数不超出套餐额度即可。旧设备不再使用时，建议在客户端内断开连接，把额度让出来。</p>\n    </details>\n\n    <details>\n      <summary>导入订阅后看不到节点怎么办？</summary>\n      <p>先确认订阅信息是否完整复制、有没有被聊天软件截断；再在客户端内手动点一次更新订阅。若仍未出现，检查客户端版本是否与订阅格式匹配，必要时换一个客户端再试一次。</p>\n    </details>\n\n    <details>\n      <summary>连接不稳定时应该先做什么？</summary>\n      <p>先换节点，再换设备，最后才考虑换套餐。多数波动来自单条线路的临时拥堵，切换到同套餐内的其他节点往往就能解决。如果多台设备、多个节点都出现同样情况，再通过支持渠道反馈。</p>\n    </details>\n\n    <details>\n      <summary>各个档位的支持方式有什么不同？</summary>\n      <p>旗舰版包含 7×24 优先工单支持，团队版在工单之外还配有专属客户经理，便于处理涉及多设备与定制路由的问题。基础版按常规渠道反馈。反馈时附上设备系统、客户端名称和出现问题的节点，会更方便定位。</p>\n    </details>\n\n    <details>\n      <summary>团队版的定制路由是什么意思？</summary>\n      <p>它指的是针对团队使用场景，对流量走向做更有针对性的配置安排，例如区分不同部门的出口策略。具体可配置的范围需要与专属客户经理沟通确认，页面上不预设未说明的能力。</p>\n    </details>\n  </div>\n</section>\n\n</main>\n\n<footer>\n  <div class=\"wrap\">\n    <strong>接班人之家（NiceCloud）</strong>\n    <p>本页用于说明套餐构成、价格与客户端使用方式。页面中的价格与权益条目以正文三张套餐卡片为准；页面未提供下载地址与开通链接，相关入口请以你的订阅信息为准。</p>\n    <p>订阅信息请妥善保管，不要公开发布或截图分享。</p>\n  </div>\n</footer>",
